# ==============================================================================
# Devotional Chants - Environment Configuration Template
# Copy this file to '.env' and adjust values for your local development setup.
# NOTE: '.env' is strictly ignored by Git to prevent leaking local paths and credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Android SDK & ADB Tooling
# ------------------------------------------------------------------------------
# Path to local Android SDK installation directory
ANDROID_SDK_ROOT=C:\Users\<username>\AppData\Local\Android\Sdk
ANDROID_HOME=C:\Users\<username>\AppData\Local\Android\Sdk

# Direct path to the adb executable
ADB_PATH=C:\Users\<username>\AppData\Local\Android\Sdk\platform-tools\adb.exe

# ------------------------------------------------------------------------------
# 2. Audio Processing Tools
# ------------------------------------------------------------------------------
# Path to FFmpeg executable used for 80 kbps AAC-LC encoding and duration analysis
FFMPEG_PATH=C:\Program Files (x86)\ClipGrab\ffmpeg.exe

# ------------------------------------------------------------------------------
# 3. Application Versioning
# ------------------------------------------------------------------------------
APP_VERSION_NAME=1.0.0
APP_VERSION_CODE=1

# ------------------------------------------------------------------------------
# 4. Release Keystore & Signing Configuration (Optional for debug/local signing)
# ------------------------------------------------------------------------------
KEYSTORE_PATH=
KEYSTORE_PASSWORD=
KEY_ALIAS=
KEY_PASSWORD=
